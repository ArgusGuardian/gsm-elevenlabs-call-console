# Copy to asterisk/secrets.env and replace every REQUIRED_ value.
# Public IPv4 addresses reachable for SIP and RTP. Never commit the completed file.
ASTERISK_PUBLIC_IP=REQUIRED_ASTERISK_PUBLIC_IP
GATEWAY_PUBLIC_IP=REQUIRED_GATEWAY_PUBLIC_IP
EL_SIP_ID=REQUIRED_ELEVENLABS_SIP_IDENTIFIER
EL_SIP_USER=REQUIRED_ELEVENLABS_DIGEST_USERNAME
EL_SIP_PASS=REQUIRED_ELEVENLABS_DIGEST_PASSWORD

# Dialling rules for your GSM gateway: e.g. a country code, national trunk prefix,
# and number of digits after that prefix. Do not include a + in the country code.
DIAL_COUNTRY_CODE=REQUIRED_COUNTRY_CODE
DIAL_NATIONAL_PREFIX=0
DIAL_LOCAL_LENGTH=REQUIRED_LOCAL_DIGIT_COUNT

# Generated by scripts/configure.py when empty. Keep these values private.
AMI_SECRET=
DASHBOARD_TOKEN=
