[global]
type=global
user_agent=GSM-Call-Console
endpoint_identifier_order=ip,username,anonymous
max_initial_qualify_time=4

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=ASTERISK_PUBLIC_IP
external_signaling_address=ASTERISK_PUBLIC_IP
local_net=127.0.0.1/32

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_media_address=ASTERISK_PUBLIC_IP
external_signaling_address=ASTERISK_PUBLIC_IP
local_net=127.0.0.1/32

; --- GSM/SIP gateway (IP peer, no REGISTER) ---
[gsm-gw]
type=aor
contact=sip:GATEWAY_PUBLIC_IP:5060
qualify_frequency=30
qualify_timeout=3

[gsm-gw]
type=endpoint
transport=transport-udp
context=from-gsm
disallow=all
allow=ulaw,alaw
aors=gsm-gw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
allow_transfer=no
ice_support=no
device_state_busy_at=1

[gsm-gw]
type=identify
endpoint=gsm-gw
match=GATEWAY_PUBLIC_IP

; --- ElevenLabs SIP ---
[elevenlabs]
type=auth
auth_type=userpass
username=EL_SIP_USER_PLACEHOLDER
password=CHANGE_ME_EL_SIP_PASS
realm=LiveKit

[elevenlabs]
type=aor
contact=sip:sip.rtc.elevenlabs.io:5060;transport=tcp
qualify_frequency=0

[elevenlabs]
type=endpoint
transport=transport-tcp
context=from-elevenlabs
disallow=all
allow=ulaw,alaw
outbound_auth=elevenlabs
aors=elevenlabs
from_domain=sip.rtc.elevenlabs.io
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
allow_transfer=no
ice_support=no
media_encryption=no
language=en
tos_audio=184

